      "autoResize": false
    },
    {
      "id": "api-endpoints",
      "type": "text",
      "x": 320,
      "y": 320,
      "width": 200,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1057722889,
      "version": 4,
      "versionNonce": 765850894,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754924798090,
      "link": null,
      "locked": false,
      "text": "Endpoints da API:\n- GET /recursos\n- POST /recursos\n- PUT /recursos/{id}\n- DELETE /recursos/{id}",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 94,
      "containerId": null,
      "originalText": "Endpoints da API:\n- GET /recursos\n- POST /recursos\n- PUT /recursos/{id}\n- DELETE /recursos/{id}",
      "lineHeight": 1.25,
      "index": "aL",
      "autoResize": true
    },
    {
      "id": "api-explanation",
      "type": "text",
      "x": 100,
      "y": 430,
      "width": 650,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1057722889,
      "version": 4,
      "versionNonce": 1604987602,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754924798090,
      "link": null,
      "locked": false,
      "text": "API (Interface de Programação de Aplicações):\n\nUma API é um conjunto de regras e protocolos que permite que diferentes aplicações\nse comuniquem entre si. Ela define os métodos e formatos de dados que as aplicações\npodem usar para solicitar e trocar informações. As APIs modernas geralmente usam\nHTTP/HTTPS e retornam dados em formatos como JSON ou XML.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 114,
      "containerId": null,
      "originalText": "API (Interface de Programação de Aplicações):\n\nUma API é um conjunto de regras e protocolos que permite que diferentes aplicações\nse comuniquem entre si. Ela define os métodos e formatos de dados que as aplicações\npodem usar para solicitar e trocar informações. As APIs modernas geralmente usam\nHTTP/HTTPS e retornam dados em formatos como JSON ou XML.",
      "lineHeight": 1.25,
      "index": "aM",
      "autoResize": true
    },
    {
      "id": "rest-explanation",
      "type": "text",
      "x": 100,
      "y": 560,
      "width": 773.6156005859375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1057722889,
      "version": 5,
      "versionNonce": 1736450894,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754924798090,
      "link": null,
      "locked": false,
      "text": "REST API:\n\nREST (Representational State Transfer) é um estilo de arquitetura que usa métodos HTTP\n(GET, POST, PUT, DELETE) para operações CRUD (Criar, Ler, Atualizar, Deletar) em recursos.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 74,
      "containerId": null,
      "originalText": "REST API:\n\nREST (Representational State Transfer) é um estilo de arquitetura que usa métodos HTTP\n(GET, POST, PUT, DELETE) para operações CRUD (Criar, Ler, Atualizar, Deletar) em recursos.",
      "lineHeight": 1.25,
      "index": "aN",
      "autoResize": true
    },
