      "link": null,
      "locked": false,
      "text": "Funcionamento de uma\nAPI",
      "fontSize": 23.001124093180994,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 25,
      "containerId": null,
      "originalText": "Funcionamento de uma API",
